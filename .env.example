# Copy this file to ".env" (same folder as main.py) and fill in at least one API key,
# or leave them all empty and run Ollama locally.

JARVIS_USER_NAME=Sarthak

# Cloud models. With JARVIS_CLOUD_PROVIDER=auto Jarvis tries OpenRouter, then xAI,
# then Gemini, then local Ollama.
JARVIS_GEMINI_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
JARVIS_CLOUD_PROVIDER=auto

# Where email drafts open: gmail, outlook, or default (your default mail app)
JARVIS_MAIL_PROVIDER=gmail

# Voice: how long Jarvis keeps listening for follow-ups without "Jarvis",
# and how long a pause ends a command.
JARVIS_AWAKE_SECONDS=180
JARVIS_SILENCE_TIMEOUT=1.2

# Optional
# JARVIS_INPUT_DEVICE=1            # microphone number if the wrong mic is used
# JARVIS_MAX_TOKENS=1024           # raise if replies get cut off
# JARVIS_OLLAMA_CONTEXT=8192
# JARVIS_AGENT=off                 # disable laptop control, chat only

# Reading your inbox (read-only). Use a Google "app password", not your normal password:
# Google Account > Security > 2-Step Verification (must be on) > App passwords.
JARVIS_EMAIL_ADDRESS=
JARVIS_EMAIL_APP_PASSWORD=
# How often to check for new mail in the background (minutes, 0 = never) and what to announce.
JARVIS_MAIL_CHECK_MINUTES=10
JARVIS_MAIL_ALERTS=important
# Extra things you consider important, e.g. professors, VIT, internships, interviews
JARVIS_MAIL_IMPORTANT_HINT=

# While you're away (you said "I'm going out", or no keyboard/mouse use for this many minutes),
# important personal emails get a short automatic "not available" reply (once a day per person).
JARVIS_AUTO_REPLY=on
JARVIS_AWAY_AFTER_MINUTES=15
# Optional custom away message. {name} = sender's first name, {user} = your name, \n = new line.
# JARVIS_AWAY_MESSAGE=Hi {name},\nI'm away right now and will reply soon.\n{user}
# While you're at the laptop, Jarvis reads important emails to you and drafts a reply ("send it" sends it).
JARVIS_DRAFT_REPLIES=on

# Jarvis's voice. Run "python voice_test.py" to hear the options.
JARVIS_NEURAL_VOICE=en-US-AvaMultilingualNeural
# Speed (e.g. +5% or -5%) and pitch (e.g. -2Hz for deeper)
JARVIS_VOICE_RATE=+0%
JARVIS_VOICE_PITCH=+0Hz

# Read your Google Calendar ("what's my schedule this afternoon?"). Google Calendar > Settings >
# your calendar > Integrate calendar > "Secret address in iCal format". Keep it private.
JARVIS_CALENDAR_ICS_URL=

# Speech recognition speed vs accuracy: beam 1 is fastest (default), 5 is a bit more accurate.
JARVIS_WHISPER_BEAM=1

# Names speech recognition should expect (artists, friends), comma separated
# JARVIS_WHISPER_WORDS=Karan Aujla, Rahul, Priya

# Password lock (set it with: python set_password.py). Only a hash is stored here.
# JARVIS_PASSWORD_HASH=
# Lock again after this many minutes unused (0 = only when you say "lock yourself")
# JARVIS_LOCK_AFTER_MINUTES=15

# Start-up animation (on/off)
# JARVIS_INTRO=on

# Second Gemini model to use when the main one is busy (empty = off)
# JARVIS_GEMINI_BACKUP_MODEL=gemini-flash-latest
